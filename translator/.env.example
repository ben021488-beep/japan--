# 二選一（只放在伺服器，絕對不要放到網頁前端）
# DeepL 免費方案（每月 50 萬字）。有填這個就會用 DeepL
DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
# 或：Claude（付費，較精準）。DEEPL_API_KEY 留空時使用
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 允許呼叫的網站來源，逗號分隔；開發時可用 *
ALLOWED_ORIGINS=https://your-site.example.com,http://localhost:8080
PORT=8787
# 每個 IP 每分鐘最多幾次請求
RATE_LIMIT_PER_MIN=20
# 單次最多幾個字
MAX_CHARS=5000
